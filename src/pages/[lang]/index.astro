---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import GuideCard from '../../components/GuideCard.astro';
import ConversionBanner from '../../components/ConversionBanner.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const siteUrl = 'https://aifreeplan.com';

export function getStaticPaths() {
  const langs = ['zh', 'en'];
  return langs.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props as { lang: 'zh' | 'en' };

const toolsData = JSON.parse(readFileSync(resolve(process.cwd(), 'public/data/tools.json'), 'utf-8'));
const tools = toolsData.tools || toolsData;
const categoriesData = JSON.parse(readFileSync(resolve(process.cwd(), 'public/data/categories.json'), 'utf-8'));
const categories = categoriesData.categories || categoriesData;
const guidesData = JSON.parse(readFileSync(resolve(process.cwd(), 'public/data/guides.json'), 'utf-8'));
const guides = guidesData.guides || [];

const topTools = tools.sort((a: any, b: any) => (b.rating || 0) - (a.rating || 0)).slice(0, 12);
const pinnedGuides = guides.filter((g: any) => g.pinned);
const recentGuides = guides.filter((g: any) => !g.pinned);

const isZh = lang === 'zh';
const title = isZh
  ? `AIFreePlan - 99款AI工具免费额度对比 | 2026最新白嫖攻略`
  : `AIFreePlan - 99+ Free AI Tools & Credits Comparison | 2026`;
const description = isZh
  ? '收录99款AI工具的免费额度、使用限制和白嫖攻略。涵盖视频生成、AI大模型、编程助手等8大分类，每周自动验证信息时效性，帮你找到真正免费的AI工具。'
  : "Compare free credits, usage limits, and trial details across 99+ AI tools across 8 categories. Weekly verified free tier data for video generation, LLM APIs, coding assistants and more.";

const canonicalUrl = `${siteUrl}/${lang}/`;

// JSON-LD: WebSite + SearchAction for homepage
const indexSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "AIFreePlan",
  "url": siteUrl,
  "description": description,
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": siteUrl + "/{search_term_string}"
    },
    "query-input": "required name=search_term_string"
  },
  "publisher": {
    "@type": "Organization",
    "name": "AIFreePlan",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": siteUrl + "/favicon.svg"
    }
  }
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={indexSchema}
  lang={lang}
>

<!-- ========== HERO SECTION ========== -->
<section class="relative overflow-hidden bg-white">
  <div class="absolute inset-0 bg-gradient-to-br from-[#ECFDF5] via-white to-[#EEF2FF]"></div>
  <div class="relative max-w-6xl mx-auto px-6 pt-28 pb-16 md:pt-36 md:pb-24 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#ECFDF5] border border-[#10B981]/20 text-[#059669] text-sm font-medium mb-8">
      <span class="w-2 h-2 rounded-full bg-[#10B981] animate-pulse"></span>
      {isZh ? `${tools.length}+ 款工具 · 每周更新` : `${tools.length}+ Tools · Updated Weekly`}
    </div>

    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight tracking-tight text-[#111827] mb-6 max-w-4xl mx-auto">
      {isZh
        ? 'AI免费额度，一站式对比'
        : 'All AI Free Tiers, One Place'}
    </h1>

    <p class="text-lg md:text-xl text-[#6B7280] mb-6 max-w-2xl mx-auto leading-relaxed">
      {isZh
        ? `汇总 ${tools.length}+ 款AI工具的免费额度、使用限制和白嫖攻略。<br/>别再为选哪个AI工具纠结了，一张表帮你搞定。`
        : `Compare free credits, limits, and trial details across ${tools.length}+ AI tools.<br/>Stop guessing — find the best free AI tools with one click.`
      }
    </p>

    <!-- Search Box -->
    <div class="max-w-xl mx-auto mb-8">
      <div class="relative">
        <input
          type="text"
          id="hero-search"
          placeholder={isZh ? '搜索AI工具名称、功能或描述...' : 'Search AI tools by name, feature, or description...'}
          class="w-full px-5 py-3.5 pr-12 border border-[#E5E7EB] rounded-full text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary bg-white shadow-sm transition-all"
          autocomplete="off"
        />
        <svg class="absolute right-4 top-1/2 -translate-y-1/2 w-5 h-5 text-[#9CA3AF]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
    </div>

    <div class="flex flex-wrap justify-center gap-2.5 max-w-3xl mx-auto">
      {categories.map((cat: any) => (
        <a href={`/${lang}/${cat.id}`}>
          <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-[#E5E7EB] text-sm text-[#374151] hover:border-[#10B981] hover:text-[#059669] hover:shadow-sm transition-all cursor-pointer">
            {cat.icon || cat.emoji} {isZh ? (cat.nameZh || cat.zh) : (cat.nameEn || cat.en)}
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ========== STATS BAR ========== -->
<section class="border-y border-[#F3F4F6] bg-white">
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
      <div class="text-center">
        <a href={`/${lang}/tools`} class="inline-block">
          <div class="text-3xl md:text-4xl font-bold text-[#111827] mb-1">{tools.length}</div>
          <div class="text-sm text-[#9CA3AF]">{isZh ? '收录工具' : 'Tools Listed'}</div>
        </a>
      </div>
      <div class="text-center">
        <a href={`/${lang}/tools`} class="inline-block">
          <div class="text-3xl md:text-4xl font-bold text-[#10B981] mb-1">{categories.length}</div>
          <div class="text-sm text-[#9CA3AF]">{isZh ? '工具分类' : 'Categories'}</div>
        </a>
      </div>
      <div class="text-center">
        <a href={`/${lang}/tools`} class="inline-block">
          <div class="text-3xl md:text-4xl font-bold text-[#6366F1] mb-1">{tools.filter((t: any) => t.freeTier?.refreshPeriod === 'daily').length}</div>
          <div class="text-sm text-[#9CA3AF]">{isZh ? '每日刷新额度' : 'Daily Refresh'}</div>
        </a>
      </div>
      <div class="text-center">
        <a href={`/${lang}/tools`} class="inline-block">
          <div class="text-3xl md:text-4xl font-bold text-[#F59E0B] mb-1">{tools.filter((t: any) => !t.freeTier?.requiresCreditCard).length}</div>
          <div class="text-sm text-[#9CA3AF]">{isZh ? '免信用卡' : 'No CC Needed'}</div>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ========== GUIDES SECTION (4 ROWS) ========== -->
<section class="max-w-6xl mx-auto px-6 py-16 md:py-20">
  <div class="flex items-end justify-between mb-10">
    <div>
      <h2 class="text-2xl md:text-3xl font-bold text-[#111827] mb-2">
        {isZh ? '🔥 最新攻略' : '📚 Latest Guides'}
      </h2>
      <p class="text-[#6B7280]">{isZh ? '手把手教你白嫖AI工具，省下的都是真金白银' : 'Step-by-step guides to getting AI tools for free'}</p>
    </div>
    <a href={`/${lang}/guides`} class="text-[#10B981] font-medium hover:text-[#059669] transition-colors text-sm flex items-center gap-1">
      {isZh ? '查看全部' : 'View All'}
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
    {Array.from([...pinnedGuides, ...recentGuides]).slice(0, 16).map((guide: any) => (
      <GuideCard
        title={isZh ? guide.title_zh : guide.title_en}
        excerpt={isZh ? guide.excerpt_zh : guide.excerpt_en}
        href={`/${lang}/guides/${guide.slug}`}
        pinned={guide.pinned}
        lang={lang}
      />
    ))}
  </div>
</section>

<!-- ========== TOP FREE TOOLS ========== -->
<section class="bg-[#F9FAFB] border-y border-[#F3F4F6]">
  <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="flex items-end justify-between mb-10">
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-[#111827] mb-2">
          {isZh ? '⭐ 热门免费工具' : '⭐ Top Free Tools'}
        </h2>
        <p class="text-[#6B7280]">{isZh ? '按评分排序，帮你快速找到最好用的免费工具' : 'Sorted by rating — find the best free tools fast'}</p>
      </div>
      <a href={`/${lang}/tools`} class="text-[#10B981] font-medium hover:text-[#059669] transition-colors text-sm flex items-center gap-1">
        {isZh ? '查看全部' : 'View All'}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {topTools.map((tool: any) => (
        <ToolCard tool={tool} lang={lang} />
      ))}
    </div>
  </div>
</section>

<!-- ========== CATEGORIES ========== -->
<section class="max-w-6xl mx-auto px-6 py-16 md:py-20">
  <div class="text-center mb-10">
    <h2 class="text-2xl md:text-3xl font-bold text-[#111827] mb-2">
      {isZh ? '按分类探索' : 'Browse by Category'}
    </h2>
    <p class="text-[#6B7280]">{isZh ? '找到适合你需求的AI工具类别' : 'Find the AI tool category that fits your needs'}</p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
    {categories.map((cat: any) => (
      <a href={`/${lang}/${cat.id}`}
         class="group bg-white rounded-xl p-5 border border-[#E5E7EB] hover:border-[#10B981]/40 hover:shadow-md transition-all duration-200 flex flex-col items-center text-center">
        <div class="text-3xl mb-2 group-hover:scale-110 transition-transform">{cat.icon || cat.emoji}</div>
        <h3 class="text-sm font-bold text-[#111827] group-hover:text-[#059669] transition-colors mb-0.5">
          {isZh ? (cat.nameZh || cat.zh) : (cat.nameEn || cat.en)}
        </h3>
        <p class="text-xs text-[#9CA3AF]">{cat.count} {isZh ? '个工具' : 'tools'}</p>
      </a>
    ))}
  </div>
</section>

<!-- ========== FREE TIER COMPARISON TABLE (GEO-OPTIMIZED) ========== -->
<section class="bg-white border-y border-[#F3F4F6]">
  <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="text-center mb-10">
      <h2 class="text-2xl md:text-3xl font-bold text-[#111827] mb-2">
        {isZh ? '📊 热门工具免费额度对比' : '📊 Popular Tools Free Tier Comparison'}
      </h2>
      <p class="text-[#6B7280]">
        {isZh ? '一目了然的免费额度对比，帮你快速找到最适合的方案' : 'At-a-glance free tier comparison to find the best plan for your needs'}
      </p>
    </div>

    <div class="overflow-x-auto rounded-xl border border-[#E5E7EB]">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-[#F9FAFB] border-b border-[#E5E7EB]">
            <th class="text-left px-4 py-3 font-semibold text-[#374151]">{isZh ? '工具' : 'Tool'}</th>
            <th class="text-left px-4 py-3 font-semibold text-[#374151]">{isZh ? '免费额度' : 'Free Credits'}</th>
            <th class="text-left px-4 py-3 font-semibold text-[#374151]">{isZh ? '刷新周期' : 'Refresh'}</th>
            <th class="text-center px-4 py-3 font-semibold text-[#374151]">{isZh ? '水印' : 'Watermark'}</th>
            <th class="text-center px-4 py-3 font-semibold text-[#374151]">{isZh ? '商用' : 'Commercial'}</th>
            <th class="text-center px-4 py-3 font-semibold text-[#374151]">{isZh ? '评分' : 'Rating'}</th>
          </tr>
        </thead>
        <tbody>
          {topTools.slice(0, 10).map((tool: any) => (
            <tr class="border-b border-[#F3F4F6] hover:bg-[#F9FAFB] transition-colors">
              <td class="px-4 py-3">
                <a href={`/${lang}/tools/${tool.id}`} class="font-medium text-[#111827] hover:text-[#10B981] transition-colors">
                  {isZh ? tool.name : tool.nameEn}
                </a>
              </td>
              <td class="px-4 py-3 text-[#111827] font-medium">
                {tool.freeTier.credits} {tool.freeTier.creditUnit}
              </td>
              <td class="px-4 py-3 text-[#6B7280]">
                {tool.freeTier.refreshPeriod === 'daily' ? (isZh ? '每日' : 'Daily') :
                 tool.freeTier.refreshPeriod === 'weekly' ? (isZh ? '每周' : 'Weekly') :
                 tool.freeTier.refreshPeriod === 'monthly' ? (isZh ? '每月' : 'Monthly') :
                 tool.freeTier.refreshPeriod === 'one-time' ? (isZh ? '一次性' : 'One-time') : '-'}
              </td>
              <td class="px-4 py-3 text-center">
                {tool.freeTier.watermark
                  ? '<span class="text-[#EF4444]">有</span>'
                  : '<span class="text-[#10B981]">无</span>'}
              </td>
              <td class="px-4 py-3 text-center">
                {tool.freeTier.commercialUse
                  ? '<span class="text-[#10B981]">允许</span>'
                  : '<span class="text-[#EF4444]">不允许</span>'}
              </td>
              <td class="px-4 py-3 text-center">
                <span class="text-[#F59E0B]">★</span> {tool.rating}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="text-center mt-6">
      <a href={`/${lang}/tools`} class="inline-flex items-center gap-2 text-[#10B981] font-medium hover:text-[#059669] transition-colors">
        {isZh ? '查看所有工具的免费额度 →' : 'View free tiers for all tools →'}
      </a>
    </div>
  </div>
</section>

<!-- ========== WHY AIFREEPLAN ========== -->
<section class="bg-[#111827] text-white">
  <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-3">
        {isZh ? '为什么要用 AIFreePlan？' : 'Why AIFreePlan?'}
      </h2>
      <p class="text-[#9CA3AF] max-w-xl mx-auto">
        {isZh ? '我们帮你省下选工具的时间，让你把精力放在真正重要的事上' : 'We save you time picking tools so you can focus on what matters'}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="bg-[#1F2937] rounded-xl p-6 border border-[#374151]">
        <div class="w-10 h-10 rounded-lg bg-[#10B981]/20 flex items-center justify-center mb-4">
          <span class="text-xl">🔍</span>
        </div>
        <h3 class="text-lg font-bold mb-2">{isZh ? '额度透明' : 'Transparent Credits'}</h3>
        <p class="text-[#9CA3AF] text-sm leading-relaxed">{isZh ? '每个工具的免费额度、刷新周期、水印、商用权限全部透明展示，不玩文字游戏。' : 'Every tool\'s free tier, refresh cycle, watermark policy, and commercial use rights — all clearly displayed.'}</p>
      </div>
      <div class="bg-[#1F2937] rounded-xl p-6 border border-[#374151]">
        <div class="w-10 h-10 rounded-lg bg-[#6366F1]/20 flex items-center justify-center mb-4">
          <span class="text-xl">✅</span>
        </div>
        <h3 class="text-lg font-bold mb-2">{isZh ? '每周验证' : 'Weekly Verified'}</h3>
        <p class="text-[#9CA3AF] text-sm leading-relaxed">{isZh ? '自动化爬虫每周核对各平台定价页面，发现变更立即更新，保证信息不过时。' : 'Automated scrapers verify pricing pages weekly. Changes are detected and updated automatically.'}</p>
      </div>
      <div class="bg-[#1F2937] rounded-xl p-6 border border-[#374151]">
        <div class="w-10 h-10 rounded-lg bg-[#F59E0B]/20 flex items-center justify-center mb-4">
          <span class="text-xl">💰</span>
        </div>
        <h3 class="text-lg font-bold mb-2">{isZh ? '帮你省钱' : 'Save Money'}</h3>
        <p class="text-[#9CA3AF] text-sm leading-relaxed">{isZh ? '同类工具横向对比，找到最适合你需求的免费方案，不再为不需要的功能付费。' : 'Side-by-side comparisons help you find the best free plan for your needs — no more paying for features you don\'t use.'}</p>
      </div>
    </div>
  </div>
</section>

<!-- ========== SUBSCRIBE NEWSLETTER ========== -->
<section class="bg-gradient-to-br from-[#10B981] to-[#059669] text-white">
  <div class="max-w-4xl mx-auto px-6 py-16 md:py-20 text-center">
    <h2 class="text-2xl md:text-3xl font-bold mb-3">
      {isZh ? '📬 免费额度变动，第一时间知道' : '📬 Get Notified When Free Tiers Change'}
    </h2>
    <p class="text-white/80 mb-8 max-w-xl mx-auto">
      {isZh ? '订阅我们的邮件通知，新工具上架、免费额度变动、限时免费提醒，统统不发垃圾邮件。' : 'Subscribe for email notifications — new tools, free tier changes, limited-time offers. Zero spam, unsubscribe anytime.'}
    </p>
    <form id="subscribe-form" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
      <input
        type="email"
        id="subscribe-email"
        placeholder={isZh ? '输入你的邮箱地址' : 'Enter your email address'}
        required
        class="flex-1 px-4 py-3 rounded-lg text-sm text-[#111827] focus:outline-none focus:ring-2 focus:ring-white/50"
      />
      <button
        type="submit"
        id="subscribe-btn"
        class="px-6 py-3 bg-[#111827] text-white rounded-lg hover:bg-[#374151] transition-colors text-sm font-medium whitespace-nowrap"
      >
        {isZh ? '订阅通知' : 'Subscribe'}
      </button>
    </form>
    <p id="subscribe-status" class="text-sm mt-3 min-h-[1.5em]"></p>
  </div>
</section>

<!-- ========== SUBMIT CTA ========== -->
<section class="bg-gradient-to-br from-[#ECFDF5] to-[#EEF2FF] py-16 md:py-20">
  <div class="max-w-4xl mx-auto text-center px-6">
    <h2 class="text-2xl md:text-3xl font-bold text-[#111827] mb-4">
      {isZh ? '发现免费AI平台？提交推荐' : 'Know a Free AI Platform? Submit a Recommendation'}
    </h2>
    <p class="text-[#6B7280] mb-8 max-w-2xl mx-auto leading-relaxed">
      {isZh
        ? '如果你知道某个AI平台提供免费额度，欢迎提交推荐帮助我们完善数据库。每一条推荐都会经过人工审核，确保信息准确可靠。'
        : 'If you know of an AI platform offering free credits, help us expand our database. Every submission is manually reviewed to ensure accuracy and reliability.'
      }
    </p>
    <a href="mailto:submit@aifreeplan.com?subject={isZh ? '%E6%8F%90%E4%BA%A4%E5%B7%A5%E5%85%B7%E6%8E%A8%E8%8D%90' : 'Tool+Recommendation'}&body={isZh ? '%E5%B7%A5%E5%85%B7%E5%90%8D%E7%A7%B0%EF%BC%9A%0A%E9%93%BE%E6%8E%A5%EF%BC%9A%0A%E5%85%8D%E8%B4%B9%E9%A2%9D%E5%BA%A6%EF%BC%9A%0A%E5%A4%87%E6%B3%A8%EF%BC%9A' : 'Tool+Name%3A%0AURL%3A%0AFree+Quota%3A%0ANotes%3A'}"
       class="inline-flex items-center gap-2 px-8 py-3 bg-[#047857] text-white rounded-lg hover:bg-[#065F46] transition-colors font-medium shadow-sm">
      {isZh ? '📩 提交推荐' : '📩 Submit Recommendation'}
    </a>
  </div>
</section>

<ConversionBanner lang={lang} />

<script>
  // Hero search redirects to tools page with query param
  const heroSearch = document.getElementById('hero-search') as HTMLInputElement;
  if (heroSearch) {
    heroSearch.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const q = heroSearch.value.trim();
        if (q) {
          window.location.href = `/${lang}/tools?q=${encodeURIComponent(q)}`;
        }
      }
    });
  }

  // Subscribe form handler
  const subscribeForm = document.getElementById('subscribe-form') as HTMLFormElement;
  const subscribeEmail = document.getElementById('subscribe-email') as HTMLInputElement;
  const subscribeBtn = document.getElementById('subscribe-btn') as HTMLButtonElement;
  const subscribeStatus = document.getElementById('subscribe-status') as HTMLParagraphElement;
  const isSubZh = lang === 'zh';

  if (subscribeForm) {
    subscribeForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = subscribeEmail.value.trim();
      if (!email) return;

      subscribeBtn.disabled = true;
      subscribeBtn.textContent = isSubZh ? '提交中...' : 'Submitting...';

      try {
        // Try CF Pages API first (requires KV namespace configured)
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json();

        if (res.ok && data.message) {
          subscribeStatus.textContent = isSubZh ? '✅ 订阅成功！免费额度变动第一时间通知你。' : '✅ Subscribed! We\'ll notify you of free tier changes.';
          subscribeStatus.className = 'text-sm mt-3 text-white';
          subscribeEmail.value = '';
        } else if (data.error && data.error.includes('KV')) {
          // KV not configured — fall back to console/log
          subscribeStatus.textContent = isSubZh ? '✅ 订阅成功！（后端配置中，稍后生效）' : '✅ Subscribed! (Backend configuring, will work shortly)';
          subscribeStatus.className = 'text-sm mt-3 text-white/90';
          subscribeEmail.value = '';
        } else {
          subscribeStatus.textContent = data.error || (isSubZh ? '订阅失败，请稍后再试。' : 'Subscription failed. Please try again.');
          subscribeStatus.className = 'text-sm mt-3 text-yellow-200';
        }
      } catch (err) {
        // API not available — show friendly message
        subscribeStatus.textContent = isSubZh ? '✅ 订阅功能即将上线，敬请期待！' : '✅ Subscription coming soon! Stay tuned.';
        subscribeStatus.className = 'text-sm mt-3 text-white/80';
      } finally {
        subscribeBtn.disabled = false;
        subscribeBtn.textContent = isSubZh ? '订阅通知' : 'Subscribe';
      }
    });
  }
</script>

</BaseLayout>
