---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCard from '../../../components/ToolCard.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

export function getStaticPaths() {
  const langs = ['zh', 'en'];
  return langs.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props as { lang: 'zh' | 'en' };
const isZh = lang === 'zh';

const toolsData = JSON.parse(readFileSync(resolve(process.cwd(), 'public/data/tools.json'), 'utf-8'));
const tools = (toolsData.tools || toolsData).sort((a: any, b: any) => (b.rating || 0) - (a.rating || 0));

const categoriesData = JSON.parse(readFileSync(resolve(process.cwd(), 'public/data/categories.json'), 'utf-8'));
const categories = categoriesData.categories || [];

const title = isZh
  ? `全部99款免费AI工具 - 免费额度/刷新周期/水印对比 | AI Free Plan 2026`
  : `All 99 Free AI Tools - Free Tier / Refresh Cycle / Watermark Comparison | AI Free Plan 2026`;
const description = isZh
  ? `99款AI工具免费额度一览：刷新周期、是否需要信用卡、水印政策、商用许可全对比。按评分排序，帮你快速找到最适合的免费AI工具。`
  : `Compare free credits, usage limits, and trial details across 99 AI tools. Sorted by rating with daily/weekly/monthly refresh comparison.`;

const canonicalUrl = `https://aifreeplan.com/${lang}/tools/`;

// Build searchable data
const searchableTools = JSON.stringify(tools.map((t: any) => ({
  id: t.id,
  name: t.name,
  nameEn: t.nameEn,
  description: t.description,
  descriptionEn: t.descriptionEn,
  category: t.category,
  categoryZh: t.categoryZh,
  categoryEn: t.categoryEn,
  rating: t.rating,
  freeTier: t.freeTier,
})));
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={toolsSchema}
  lang={lang}
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-3xl font-bold mb-2">{isZh ? '全部免费AI工具' : 'All Free AI Tools'}</h1>
    <p class="text-text-muted mb-6">{isZh ? '按评分排序，共收录91款AI工具' : 'Sorted by rating, 91 AI tools listed'}</p>

    <!-- Search Box -->
    <div class="mb-6">
      <div class="relative max-w-xl">
        <input
          type="text"
          id="tool-search"
          placeholder={isZh ? '搜索工具名称、描述或功能...' : 'Search tools by name, description, or features...'}
          class="w-full px-4 py-3 pr-10 border border-border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all"
          autocomplete="off"
        />
        <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <div id="search-count" class="text-xs text-text-muted mt-2 hidden">
        {isZh ? '找到' : 'Found'} <span id="match-count">0</span> {isZh ? '个工具' : 'tools'}
      </div>
    </div>

    <!-- Category Filter -->
    <div class="flex flex-wrap gap-2 mb-8">
      <button
        onclick="filterTools('all')"
        class="category-btn px-4 py-2 rounded-full text-sm font-medium bg-primary text-white border border-primary"
        data-category="all"
      >
        {isZh ? '全部' : 'All'} ({tools.length})
      </button>
      {categories.map((cat: any) => (
        <button
          onclick="filterTools('${cat.id}')"
          class="category-btn px-4 py-2 rounded-full text-sm font-medium bg-white text-text-muted border border-border hover:border-primary hover:text-primary"
          data-category="${cat.id}"
        >
          {cat.icon} {isZh ? cat.nameZh : cat.nameEn} ({cat.count})
        </button>
      ))}
    </div>

    <!-- Tools Grid -->
    <div id="tools-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tools.map((tool: any) => (
        <ToolCard tool={tool} lang={lang} />
      ))}
    </div>

    <!-- No Results -->
    <div id="no-results" class="hidden text-center py-16">
      <p class="text-4xl mb-4">🔍</p>
      <p class="text-lg text-text-muted mb-2">
        {isZh ? '没有找到匹配的工具' : 'No tools found'}
      </p>
      <p class="text-sm text-text-muted">
        {isZh ? '试试其他关键词或浏览所有工具' : 'Try different keywords or browse all tools'}
      </p>
    </div>
  </div>

  <script client:load>
    // Tool data for search
    const allTools = ${searchableTools};

    const searchInput = document.getElementById('tool-search') as HTMLInputElement;
    const searchCount = document.getElementById('search-count');
    const matchCount = document.getElementById('match-count');
    const noResults = document.getElementById('no-results');
    const toolsGrid = document.getElementById('tools-grid');

    let currentCategory = 'all';

    function filterTools(category) {
      currentCategory = category;
      const cards = toolsGrid.querySelectorAll('[data-tool-id]');
      const buttons = document.querySelectorAll('.category-btn');

      // Update button styles
      buttons.forEach(btn => {
        if (btn.dataset.category === category) {
          btn.classList.remove('bg-white', 'text-text-muted', 'border-border');
          btn.classList.add('bg-primary', 'text-white', 'border-primary');
        } else {
          btn.classList.remove('bg-primary', 'text-white', 'border-primary');
          btn.classList.add('bg-white', 'text-text-muted', 'border-border');
        }
      });

      applyFilters();
    }

    function applyFilters() {
      const query = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;

      allTools.forEach((tool: any, index) => {
        const card = toolsGrid.children[index];
        if (!card) return;

        const catMatch = currentCategory === 'all' || tool.category === currentCategory.toUpperCase() ||
                         tool.categoryZh === currentCategory || tool.categoryEn === currentCategory ||
                         tool.id.includes(currentCategory);

        let searchMatch = true;
        if (query) {
          const searchText = [
            tool.name, tool.nameEn, tool.description, tool.descriptionEn,
            tool.categoryZh, tool.categoryEn, tool.category,
            tool.freeTier?.creditUnit || ''
          ].join(' ').toLowerCase();
          searchMatch = searchText.includes(query);
        }

        const visible = catMatch && searchMatch;
        card.style.display = visible ? '' : 'none';

        if (visible) {
          visibleCount++;
        }
      });

      // Update search count display
      if (query) {
        searchCount.classList.remove('hidden');
        matchCount.textContent = visibleCount.toString();
      } else {
        searchCount.classList.add('hidden');
      }

      // Show/hide no results
      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    }

    // Debounced search
    let searchTimeout: ReturnType<typeof setTimeout>;
    searchInput.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(applyFilters, 150);
    });

    // Mark cards with tool IDs for proper filtering
    toolsGrid.querySelectorAll('a[href]').forEach(a => {
      const card = a.closest('[data-tool-id]') || a.parentElement?.closest('[data-tool-id]');
    });

    // Handle ?q= query param from hero search
    const urlParams = new URLSearchParams(window.location.search);
    const qParam = urlParams.get('q');
    if (qParam) {
      searchInput.value = decodeURIComponent(qParam);
      applyFilters();
    }
  </script>

  <script>
    const searchInput = document.getElementById('tool-search');
    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        const query = e.target.value.toLowerCase().trim();
        const cards = document.querySelectorAll('a[href*="/tools/"]');
        if (!query) {
          cards.forEach(card => card.style.display = '');
          return;
        }
        cards.forEach(card => {
          const text = card.textContent.toLowerCase();
          card.style.display = text.includes(query) ? '' : 'none';
        });
      });
    }
  </script>
</BaseLayout>
