---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

export function getStaticPaths() {
  const data = JSON.parse(readFileSync(resolve(process.cwd(), 'public/data/guides.json'), 'utf-8'));
  const guides = data.guides || [];
  const langs = ['zh', 'en'];
  return langs.flatMap((lang) =>
    guides.map((guide) => ({
      params: { lang, slug: guide.slug },
      props: { guide, lang },
    }))
  );
}

const { guide, lang } = Astro.props as { guide: any; lang: 'zh' | 'en' };
const isZh = lang === 'zh';

const title = isZh ? `${guide.title_zh} - AI Free Plan` : `${guide.title_en} - AI Free Plan`;
const description = isZh ? (guide.excerpt_zh || guide.title_zh) : (guide.excerpt_en || guide.title_en);

// Try to load static HTML content — match any <main> tag with any class
let bodyContent = '';
const staticHtmlPath = resolve(process.cwd(), isZh ? 'zh/guides' : 'en/guides', `${guide.slug}.html`);
try {
  const staticHtml = readFileSync(staticHtmlPath, 'utf-8');
  // Find first <main ...> tag (any class or no class)
  const mainOpenMatch = staticHtml.match(/<main\b[^>]*>/);
  const mainCloseIdx = staticHtml.indexOf('</main>');
  if (mainOpenMatch && mainCloseIdx !== -1 && mainOpenMatch.index < mainCloseIdx) {
    const mainOpenEnd = mainOpenMatch.index + mainOpenMatch[0].length;
    bodyContent = staticHtml.substring(mainOpenEnd, mainCloseIdx);
  }
} catch (e) {
  // No static HTML yet
}

const siteUrl = 'https://aifreeplan.com';
const canonicalUrl = `${siteUrl}/${lang}/guides/${guide.slug}/`;
const publishedDate = guide.datePublished || new Date().toISOString();
const modifiedDate = guide.dateModified || new Date().toISOString();

// JSON-LD: Article
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": publishedDate,
  "dateModified": modifiedDate,
  "author": {
    "@type": "Organization",
    "name": "AIFreePlan"
  },
  "publisher": {
    "@type": "Organization",
    "name": "AIFreePlan",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": siteUrl + "/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={articleSchema}
  lang={lang}
>
  <div class="max-w-4xl mx-auto">
    <a href={`/${lang}/guides`} class="text-sm text-text-muted hover:text-primary mb-6 inline-block">&larr; {isZh ? '返回攻略列表' : 'Back to Guides'}</a>
    
    <h1 class="text-3xl font-bold mb-4">{isZh ? guide.title_zh : guide.title_en}</h1>
    <p class="text-text-muted mb-8">{isZh ? guide.excerpt_zh : guide.excerpt_en}</p>

    <div class="prose prose-lg max-w-none">
      {bodyContent ? <div set:html={bodyContent} /> : <p class="text-text-muted">{isZh ? '攻略内容待补充...' : 'Guide content coming soon...'}</p>}
    </div>
  </div>
</BaseLayout>
