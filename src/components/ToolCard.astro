---
import type { AITool } from '../types';

interface Props {
  tool: AITool;
  lang?: 'zh' | 'en';
}

const { tool, lang = 'zh' } = Astro.props;

const name = lang === 'zh' ? tool.name : tool.nameEn;
const description = lang === 'zh' ? tool.description : tool.descriptionEn;
const category = lang === 'zh' ? tool.categoryZh : tool.categoryEn;
const paidFrom = lang === 'zh' ? tool.paidFrom : tool.paidFromEn;

const refreshLabel: Record<string, string> = {
  daily: lang === 'zh' ? '每日' : 'Daily',
  weekly: lang === 'zh' ? '每周' : 'Weekly',
  monthly: lang === 'zh' ? '每月' : 'Monthly',
  'one-time': lang === 'zh' ? '一次性' : 'One-time',
  unknown: lang === 'zh' ? '未知' : 'Unknown',
};

// Status badge configuration
const statusConfig: Record<string, { label: Record<string, string>; color: string; bg: string }> = {
  '长期免费': {
    label: { zh: '长期免费', en: 'Long-term Free' },
    color: 'text-emerald-700',
    bg: 'bg-emerald-100',
  },
  '每日刷新': {
    label: { zh: '每日刷新', en: 'Daily Refresh' },
    color: 'text-blue-700',
    bg: 'bg-blue-100',
  },
  '每月刷新': {
    label: { zh: '每月刷新', en: 'Monthly Refresh' },
    color: 'text-indigo-700',
    bg: 'bg-indigo-100',
  },
  '有限额度': {
    label: { zh: '有限额度', en: 'Limited Credits' },
    color: 'text-orange-700',
    bg: 'bg-orange-100',
  },
  '免费可用': {
    label: { zh: '免费可用', en: 'Free Available' },
    color: 'text-gray-700',
    bg: 'bg-gray-100',
  },
  '公测中': {
    label: { zh: '公测中', en: 'Beta' },
    color: 'text-purple-700',
    bg: 'bg-purple-100',
  },
};

const status = statusConfig[tool.freeStatus || ''] || statusConfig['免费可用'];
---

<article data-tool-id="{tool.id}" class="flex flex-col bg-white rounded-xl border border-[#E5E7EB] p-5 hover:shadow-md hover:border-[#10B981]/30 transition-all duration-200 h-full" style="overflow: visible;">
  <div class="mb-3">
    <div class="flex items-start justify-between mb-2">
      <h3 class="text-lg font-bold leading-tight">
        <a href={`/${lang}/tools/${tool.id}`} class="hover:text-[#10B981]">
          {name}
        </a>
      </h3>
      <span class="text-sm font-semibold text-[#F59E0B] whitespace-nowrap ml-2">
        <svg class="inline w-3.5 h-3.5 -mt-0.5" fill="#F59E0B" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        {tool.rating}
      </span>
    </div>
    <div class="flex items-center gap-2 mb-2">
      <span class="inline-block px-2.5 py-1 text-xs font-medium rounded-md bg-[#D1FAE5] text-[#065F46]">
        {category}
      </span>
      <span class="inline-block px-2 py-0.5 text-xs font-medium rounded-md {status.bg} {status.color}">
        {status.label[lang]}
      </span>
    </div>
  </div>

  <p class="text-sm text-[#6B7280] mb-4 line-clamp-2 flex-shrink-0 leading-relaxed">{description}</p>

  <div class="mb-4 flex-shrink-0 space-y-1.5">
    <div class="flex items-center gap-2 text-sm">
      <span class="text-[#10B981]">🆓</span>
      <span class="font-semibold text-[#111827]">{tool.freeTier.credits} {tool.freeTier.creditUnit}</span>
      <span class="text-[#9CA3AF] text-xs">({refreshLabel[tool.freeTier.refreshPeriod]})</span>
    </div>
    {tool.freeTier.requiresCreditCard && (
      <div class="flex items-center gap-2 text-sm text-[#EF4444]">
        <span>💳</span>
        <span>{lang === 'zh' ? '需要信用卡' : 'Credit card required'}</span>
      </div>
    )}
    {paidFrom && (
      <div class="text-sm text-[#9CA3AF]">
        {lang === 'zh' ? '付费起步' : 'Paid from'}: {paidFrom}
      </div>
    )}
  </div>

  <a
    href={`/${lang}/tools/${tool.id}`}
    class="mt-auto block text-center bg-[#047857] text-white text-sm font-medium rounded-lg px-4 py-2.5 hover:bg-[#065F46] transition-colors"
  >
    {lang === 'zh' ? '查看详情' : 'View Details'}
  </a>
</article>
