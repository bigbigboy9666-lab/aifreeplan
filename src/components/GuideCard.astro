---
interface Props {
  title: string;
  excerpt: string;
  href: string;
  pinned?: boolean;
  lang?: 'zh' | 'en';
}

const { title, excerpt, href, pinned = false, lang = 'zh' } = Astro.props;

const icons = ['📘', '📖', '🍎', '⚡', '💻', '🎯', '🤖', '🚀', '📝', '🎬', '🔧', '🌐', '📊', '🎨', '🔊', '💡', '🛠️', '📱', '🔐', '🧠', '🎮', '📈', '🤝', '🏆', '🔮'];
const iconColors = [
  'from-emerald-500 to-green-600',
  'from-blue-500 to-indigo-600',
  'from-amber-500 to-orange-600',
  'from-purple-500 to-violet-600',
  'from-rose-500 to-pink-600',
  'from-cyan-500 to-teal-600',
  'from-lime-500 to-green-600',
  'from-sky-500 to-blue-600',
];

// Pick icon based on hash of title for consistency
const titleHash = title.split('').reduce((a, b) => a + b.charCodeAt(0), 0);
const iconIdx = titleHash % icons.length;
const colorIdx = titleHash % iconColors.length;
const icon = icons[iconIdx];
const iconColor = iconColors[colorIdx];
---

<a
  href={href}
  class="group block rounded-xl border border-[#E5E7EB] bg-white p-5 transition-all duration-200 hover:shadow-lg hover:-translate-y-0.5 hover:border-[#10B981]/30 h-full flex flex-col"
>
  <div class="flex items-start gap-3 mb-3">
    <div class="w-10 h-10 rounded-xl bg-gradient-to-br {iconColor} flex items-center justify-center text-white text-lg flex-shrink-0 shadow-sm group-hover:scale-105 transition-transform duration-200">
      {icon}
    </div>
    <div class="flex-1 min-w-0">
      {pinned && (
        <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-semibold rounded-md bg-[#ECFDF5] text-[#059669] border border-[#10B981]/20">
          <span class="w-1.5 h-1.5 rounded-full bg-[#10B981] animate-pulse"></span>
          {lang === 'zh' ? '置顶' : 'Pinned'}
        </span>
      )}
    </div>
  </div>

  <h3 class="text-sm font-bold leading-snug mb-1.5 line-clamp-2 text-[#111827] group-hover:text-[#059669] transition-colors">
    {title}
  </h3>
  <p class="text-xs text-[#6B7280] line-clamp-2 leading-relaxed mb-4 flex-1">
    {excerpt}
  </p>

  <div class="flex items-center justify-between pt-3 border-t border-[#F3F4F6]">
    <span class="text-[10px] font-semibold uppercase tracking-wider text-[#9CA3AF]">
      {lang === 'zh' ? '攻略' : 'Guide'}
    </span>
    <span class="inline-flex items-center gap-1 text-xs font-semibold text-[#10B981] group-hover:gap-2 transition-all">
      {lang === 'zh' ? '阅读' : 'Read'}
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
    </span>
  </div>
</a>
