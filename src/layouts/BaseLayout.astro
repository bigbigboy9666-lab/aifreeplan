---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  lang?: 'zh' | 'en';
}

const {
  title,
  description,
  canonicalUrl,
  jsonLd,
  lang = 'zh',
} = Astro.props;

const siteUrl = 'https://aifreeplan.com';
const currentPath = Astro.url.pathname;
// Ensure trailing slash for consistency
const normalizedPath = currentPath.endsWith('/') ? currentPath : currentPath + '/';
// Strip lang prefix for cross-language matching: /zh/tools/ -> tools/
const pathWithoutLang = normalizedPath.replace(/^\/(zh|en)\//, '');
const zhUrl = `${siteUrl}/zh/${pathWithoutLang}`;
const enUrl = `${siteUrl}/en/${pathWithoutLang}`;
// Determine if this is homepage
const isHomepage = normalizedPath === '/zh/' || normalizedPath === '/en/';
const isToolPage = normalizedPath.includes('/tools/');
const isGuidePage = normalizedPath.includes('/guides/');
const isCategoryPage = normalizedPath.match(/\/(zh|en)\/(llm|image|video|coding|audio|chat|agent|productivity|ai-assistant)\/?$/);
const isToolsIndex = normalizedPath === '/tools/' || normalizedPath === '/zh/tools/' || normalizedPath === '/en/tools/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl || `${siteUrl}${normalizedPath}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- hreflang tags -->
    <link rel="alternate" hreflang="zh" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={isToolPage ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl || `${siteUrl}${normalizedPath}`} />
    <meta property="og:site_name" content="AI Free Plan" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />
    <meta property="og:image" content="https://aifreeplan.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === 'zh' ? 'AIFreePlan - AI免费额度聚合平台' : 'AIFreePlan - AI Free Tier Aggregator'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://aifreeplan.com/og-image.png" />
    <meta name="twitter:domain" content="aifreeplan.com" />

    <title>{title}</title>

    <!-- JSON-LD -->
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(
          Array.isArray(jsonLd) ? jsonLd : [jsonLd]
        )}
      />
    )}

    <!-- Homepage: WebSite + Organization + CollectionSchema -->
    {isHomepage && (
      <>
        <script type="application/ld+json">
          {JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": lang === 'zh' ? 'AIFreePlan' : 'AIFreePlan',
            "url": siteUrl + '/',
            "description": lang === 'zh' ? '全球首个AI工具免费额度聚合平台' : "The world's first AI free tier aggregation platform",
            "potentialAction": {
              "@type": "SearchAction",
              "target": {
                "@type": "EntryPoint",
                "urlTemplate": siteUrl + '/{search_term_string}'
              },
              "query-input": "required name=search_term_string"
            },
            "inLanguage": [lang === 'zh' ? 'zh-CN' : 'en-US', lang === 'zh' ? 'en-US' : 'zh-CN'],
            "publisher": {
              "@type": "Organization",
              "name": "AIFreePlan",
              "url": siteUrl + '/',
              "logo": {
                "@type": "ImageObject",
                "url": siteUrl + '/favicon.svg'
              },
              "sameAs": []
            }
          })}
        </script>
        <script type="application/ld+json">
          {JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Collection",
            "name": lang === 'zh' ? 'AI免费额度聚合' : 'AI Free Tier Aggregation',
            "description": lang === 'zh' ? '收录91+款AI工具的免费额度和使用限制对比' : 'Comparing free tiers and usage limits across 91+ AI tools',
            "numberOfItems": 91,
            "url": siteUrl + '/',
            "inLanguage": [lang === 'zh' ? 'zh-CN' : 'en-US', lang === 'zh' ? 'en-US' : 'zh-CN'],
            "datePublished": "2026-01-01",
            "dateModified": new Date().toISOString().split('T')[0],
            "publisher": {
              "@type": "Organization",
              "name": "AIFreePlan",
              "url": siteUrl + '/'
            }
          })}
        </script>
      </>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="redesign-nav">
      <nav class="redesign-nav-inner">
        <a href={`/${lang}`} class="redesign-nav-logo">
          🤖 AI<span>Free</span>Plan
        </a>
        <div class="redesign-nav-links">
          <a href={`/${lang}`}>
            {lang === 'zh' ? '首页' : 'Home'}
          </a>
          <a href={`/${lang}/guides`}>
            {lang === 'zh' ? '攻略' : 'Guides'}
          </a>
          <a href={`/${lang}/tools`}>
            {lang === 'zh' ? '工具' : 'Tools'}
          </a>
          <a href={`/${lang}/faq`}>
            {lang === 'zh' ? 'FAQ' : 'FAQ'}
          </a>
          <a href={`/${lang === 'zh' ? 'en' : 'zh'}`} class="redesign-nav-lang">
            {lang === 'zh' ? 'EN' : '中文'}
          </a>
        </div>
      </nav>
    </header>

    <main class="flex-1 w-full">
      <slot />
    </main>

    <footer class="bg-white border-t border-border mt-auto">
      <div class="max-w-6xl mx-auto px-4 py-6 text-center text-sm text-text-muted">
        <p>&copy; {new Date().getFullYear()} AI Free Plan. {lang === 'zh' ? '免费AI工具大全，每日更新。' : 'Free AI tools directory, updated daily.'}</p>
      </div>
    </footer>
  </body>
</html>
